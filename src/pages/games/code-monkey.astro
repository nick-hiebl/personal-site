---
import { getCollection } from 'astro:content'

import { Game } from '../../content/games/canvas-games/code-monkey'
import GameLayout from '../../layouts/Game.astro'

const games = await getCollection('games')

const game = games.find(game => game.data.gameId === 'code-monkey')!
---
<GameLayout {...game.data}>
    <Game client:only />
</GameLayout>
